{
  "Jwt": {
    "Issuer": "https://tennet.local",
    "Audience": "tennet-api"
  },
  "ConnectionStrings": {
    "Inventory": "Data Source=tennet.db"
  },
  "Tenancy": {
    "Subdomain": {
      "Enabled": false,
      "BaseDomain": "tennet.local"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
